server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve backend container names at request time, not at startup.
    #
    # With a literal hostname in proxy_pass, nginx resolves it while loading the
    # config and exits with "host not found in upstream" if it cannot. Lightsail
    # starts every container in parallel, so nginx routinely boots before the
    # backends have DNS entries — it died, failed the public health check, and
    # the whole deployment was retried three times and marked FAILED.
    #
    # Putting the host in a variable defers the lookup to each request, so the
    # frontend serves the site immediately and a backend that is still starting
    # costs one 502 instead of the entire deployment.
    # ${DNS_RESOLVER} is filled in at container start from the container's own
    # /etc/resolv.conf, so this works on Lightsail, plain Docker or anywhere
    # else without hardcoding a platform-specific DNS address.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    # Static lab files (self-contained HTML prototypes)
    location /labs/ {
        try_files $uri $uri/ =404;
    }

    # KYC WebSocket / API proxy — forwarded to the backend container
    location /ws/ {
        set                $kyc kyc-backend;
        proxy_pass         http://$kyc:8003;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_read_timeout 3600s;
    }

    location /api/ {
        set                $kyc kyc-backend;
        proxy_pass         http://$kyc:8003;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
    }

    # Push-payment scams API proxy
    location /pp-api/ {
        rewrite            ^/pp-api/(.*)$ /$1 break;
        set                $pushpay pushpay;
        proxy_pass         http://$pushpay:8000;
        proxy_set_header   Host $host;
    }

    # Chatbot API proxy
    location /cb-api/ {
        rewrite            ^/cb-api/(.*)$ /$1 break;
        set                $chatbot chatbot;
        proxy_pass         http://$chatbot:8001;
        proxy_set_header   Host $host;
    }

    # Voice-auth live clone proxy
    location /va-api/ {
        rewrite            ^/va-api/(.*)$ /$1 break;
        set                $voiceauth voiceauth;
        proxy_pass         http://$voiceauth:8002;
        proxy_set_header   Host $host;
        # Cloning uploads audio and the dubbing job takes a while to return.
        client_max_body_size 20m;
        proxy_read_timeout   300s;
    }

    # SPA fallback — everything else goes to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Compression
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
