{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEventLog",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query",
        "dynamodb:GetItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/CardingEventLog"
      ]
    },
    {
      "Sid": "WriteRiskScoreOntoCard",
      "Effect": "Allow",
      "Action": [
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/MockIssuerDB"
      ]
    },
    {
      "Sid": "ConsumeIssuerStream",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeStream",
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator",
        "dynamodb:ListStreams"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/MockIssuerDB/stream/*"
      ]
    }
  ]
}
